<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.0</Version>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization>
        <RootNamespace>Molinex.Platform</RootNamespace>
        <UserSecretsId>Molinex.Platform.LocalDevelopment</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- EntityFrameworkCore persistence -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- MySQL provider -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
        <!-- Naming conventions -->
        <PackageReference Include="Humanizer" Version="3.0.10" />
        <!-- OpenAPI documentation -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.1.2" />
        <!-- Password hashing -->
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
        <!-- JSON Web Tokens -->
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
        <!-- Mediator -->
        <PackageReference Include="Cortex.Mediator" Version="3.1.2" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Errors\ErrorMessages.es.resx">
            <DependentUpon>ErrorMessages.cs</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\Shared\CommonMessages.es.resx">
            <DependentUpon>CommonMessages.cs</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>

</Project>
